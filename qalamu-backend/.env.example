PORT=3000
JWT_SECRET=ganti-dengan-string-acak-panjang
# API key untuk fitur koreksi tulisan (opsional saat development, ada mode mock)
# Model Google Gemini yang cocok untuk OCR teks Arab dan analisis tata bahasa:
# - gemini-2.5-flash (Direkomendasikan: cepat, sangat akurat membaca teks/harakat Arab, dan hemat kuota)
# - gemini-2.5-pro   (Alternatif: penalaran lebih mendalam untuk kalimat kompleks)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Opsional: alternatif Anthropic Claude
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Opsional, untuk hosting ---
# Jumlah proxy di depan server (umumnya 1 di hosting). Biarkan kosong bila server diakses langsung.
# TRUST_PROXY=1
# Lokasi penyimpanan foto dan database. Isi dengan alamat disk permanen di hosting (folder induknya harus sudah ada).
# UPLOAD_DIR=/data/uploads
# QALAMU_DB_PATH=/data/qalamu.db
